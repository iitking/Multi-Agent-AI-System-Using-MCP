# ==============================================================================
# Enterprise Multi-Agent AI System — Configuration Example
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development

# Authentication API keys formatted as: key:username:role (roles: viewer | analyst | admin)
API_KEYS=dev-admin-key:admin:admin,dev-analyst-key:analyst:analyst,dev-viewer-key:viewer:viewer

# Directories
DATA_DIR=data
DOCS_DIR=data/company_docs
REPORTS_DIR=data/reports

# Databases
# Defaults to SQLite files in DATA_DIR. For PostgreSQL in production, use:
# ANALYTICS_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/analytics
ANALYTICS_DATABASE_URL=sqlite:///data/sales.db
# Optional read-only credentials for analytics
ANALYTICS_READONLY_DATABASE_URL=
# Application metadata (runs, audit trail)
APP_DATABASE_URL=sqlite:///data/app.db

# Large Language Model (Optional - system operates with deterministic fallback if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_PRICE_IN_PER_1K=0.00015
LLM_PRICE_OUT_PER_1K=0.0006

# LangSmith Observability & Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-multi-agent-ai

# Orchestration & Security Guards
MAX_REVIEW_RETRIES=2
MCP_TOOL_TIMEOUT=30
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# n8n External Automation & Human Approval
N8N_WEBHOOK_URL=http://localhost:5678/webhook/sales-action
N8N_WEBHOOK_SECRET=secret_n8n_token_123
ALLOWED_EMAIL_DOMAINS=company.com,enterprise.io
